# Copy to .env and fill in real values. NEVER commit .env.

# --- Required ---
MONGODB_URI=
JWT_SECRET=
# Access-token lifetime. Sessions are cookie-based: a short access JWT (mp_access) plus a
# rotating 7-day refresh cookie (mp_refresh), see src/auth/session.js.
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_DAYS=7

# --- Server ---
NODE_ENV=development
PORT=4000
HOST=
API_BASE_URL=http://localhost:4000
APP_BASE_URL=http://localhost:5173
# Comma separated list or JSON array of allowed origins.
# Must be set in production: when empty there, cross-origin requests are denied.
CORS_ORIGIN=http://localhost:5173
CORS_ENABLED=true
# Express "trust proxy". Leave empty: false on Lambda (API Gateway sourceIp),
# "loopback" locally. Set to a number (e.g. 1) when behind CloudFront/another proxy.
TRUST_PROXY=
# Serve Swagger at /docs outside development.
ENABLE_API_DOCS=false
PLANS_CACHE_TTL_MS=60000
# "mongo" (default, shared across Lambda instances) or "memory".
RATE_LIMIT_STORE=mongo

# --- Auth / Google ---
GOOGLE_CLIENT_ID=

# --- Email (SMTP) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_SECURE=false
SUPPORT_EMAIL=
VERIFICATION_RESEND_COOLDOWN_SECONDS=120

# --- Uploads ---
# Optional environment-aware storage. Blank preserves existing configuration.
# local/development -> dev; prod -> production; "dev 2" -> dev2.
# With APP_ENV set and no explicit bucket: soulmed-{env}-uploads-thumbnails.
# The AI service also inherits APP_ENV from this file unless overridden.
APP_ENV=
# Recommended: one bucket per environment, two service folders inside.
# AWS_ACCOUNT_ID=123456789012
# S3_BUCKET=soulmed-{env}-{account_id}
# Shared S3_BUCKET takes precedence over UPLOADS_S3_BUCKET and the AI bucket.
# Objects: soulmed-<env>-uploads-thumbnails/<existing key>.
# Without S3_BUCKET/AWS_ACCOUNT_ID, legacy separate-bucket settings still apply.
# Explicit buckets take precedence; {env} templates are supported, e.g.
# UPLOADS_S3_BUCKET=soulmed-{env}-uploads-thumbnails-ACCOUNT_ID
# Provision buckets/IAM/CORS before enabling; no buckets are created by the app.
# Local directory for uploads when no S3 bucket is configured.
UPLOADS_DIR=
UPLOADS_S3_BUCKET=
UPLOADS_S3_REGION=
# Optional: CloudFront/custom domain in front of the bucket, e.g. https://cdn.example.com
UPLOADS_PUBLIC_BASE_URL=
# AWS credentials for the bucket (server-side only). On Lambda use the execution role instead.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=

# --- Logging ---
# Logging: one JSON line per request/event to stdout (pino). LOG_LEVEL is
# fatal|error|warn|info|debug; production runs at info. LOG_DIR additionally
# mirrors the stream into a daily file (local/VPS only; ignored on Lambda).
LOG_LEVEL=info
LOG_DIR=
# With APP_ENV: files go to LOG_DIR/<environment>/backend/.
LOG_FILE_PREFIX=
LOG_ENV_NAME=
LOG_APP_NAME=
# Error tracking (Sentry). Leave SENTRY_DSN empty to disable — everything
# still logs, nothing is shipped. The DSN is not a secret.
SENTRY_DSN=
SENTRY_ENVIRONMENT=
SENTRY_TRACES_SAMPLE_RATE=0.1

# --- Secrets / integrations ---
# Encrypts settings stored in Mongo (e.g. the OpenAI key).
APP_ENCRYPTION_KEY=
OPENAI_API_KEY=
TUTOR_MODEL=gpt-4o-mini
TUTOR_MAX_TOKENS=600
TUTOR_BATCH_SIZE=5
VIDEO_AI_MODEL=
VIDEO_AI_MAX_TOKENS=400
VIDEO_AI_CHAT_MAX_TOKENS=600

ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
ZOOM_WEBHOOK_SECRET_TOKEN=

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_STREAM_TOKEN=
CLOUDFLARE_STREAM_SIGNING_KEY=
CLOUDFLARE_STREAM_SIGNING_KEY_ID=

GEOIP_ENABLED=false
GEOIP_PROVIDER=
GEOIP_TOKEN=

# Bunny Stream (hosted lecture videos). Values live in .env only.
VIDEO_PROVIDER=bunny
BUNNY_STREAM_LIBRARY_ID=
BUNNY_STREAM_API_KEY=
BUNNY_STREAM_READONLY_API_KEY=
BUNNY_STREAM_TOKEN_KEY=
BUNNY_STREAM_CDN_HOSTNAME=
BUNNY_PLAYBACK_TOKEN_TTL=14400
