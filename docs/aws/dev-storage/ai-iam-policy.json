{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Action": "s3:GetBucketLocation",
      "Resource": "arn:aws:s3:::soulmed-dev-uploads"
    },
    {
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::soulmed-dev-uploads",
      "Condition": {
        "StringLike": {
          "s3:prefix": [
            "soulmed-dev-ai-ingest",
            "soulmed-dev-ai-ingest/*"
          ]
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:PutObject",
        "s3:DeleteObject",
        "s3:AbortMultipartUpload",
        "s3:ListMultipartUploadParts"
      ],
      "Resource": "arn:aws:s3:::soulmed-dev-uploads/soulmed-dev-ai-ingest/*"
    }
  ]
}
