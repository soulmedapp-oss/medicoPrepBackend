# Copy to .env and fill in real values. NEVER commit .env.

# --- Required ---
MONGODB_URI=
JWT_SECRET=
JWT_EXPIRES_IN=7d

# --- Server ---
NODE_ENV=development
PORT=4000
HOST=
API_BASE_URL=http://localhost:4000
APP_BASE_URL=http://localhost:5173
# Comma separated list or JSON array of allowed origins.
# Must be set in production: when empty there, cross-origin requests are denied.
CORS_ORIGIN=http://localhost:5173
CORS_ENABLED=true
# Express "trust proxy". Leave empty: false on Lambda (API Gateway sourceIp),
# "loopback" locally. Set to a number (e.g. 1) when behind CloudFront/another proxy.
TRUST_PROXY=
# Serve Swagger at /docs outside development.
ENABLE_API_DOCS=false
PLANS_CACHE_TTL_MS=60000
# "mongo" (default, shared across Lambda instances) or "memory".
RATE_LIMIT_STORE=mongo

# --- Auth / Google ---
GOOGLE_CLIENT_ID=

# --- Email (SMTP) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_SECURE=false
SUPPORT_EMAIL=
VERIFICATION_RESEND_COOLDOWN_SECONDS=120

# --- Uploads ---
# Local directory for uploads when no S3 bucket is configured.
UPLOADS_DIR=
UPLOADS_S3_BUCKET=
UPLOADS_S3_REGION=
AWS_REGION=

# --- Logging ---
LOG_DIR=
LOG_FILE_PREFIX=
LOG_ENV_NAME=
LOG_APP_NAME=
LOG_CONSOLE_LEVEL=info
LOG_FILE_LEVEL=info

# --- Secrets / integrations ---
# Encrypts settings stored in Mongo (e.g. the OpenAI key).
APP_ENCRYPTION_KEY=
OPENAI_API_KEY=
TUTOR_MODEL=gpt-4o-mini
TUTOR_MAX_TOKENS=600
TUTOR_BATCH_SIZE=5
VIDEO_AI_MODEL=
VIDEO_AI_MAX_TOKENS=400
VIDEO_AI_CHAT_MAX_TOKENS=600

ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
ZOOM_WEBHOOK_SECRET_TOKEN=

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_STREAM_TOKEN=
CLOUDFLARE_STREAM_SIGNING_KEY=
CLOUDFLARE_STREAM_SIGNING_KEY_ID=

GEOIP_ENABLED=false
GEOIP_PROVIDER=
GEOIP_TOKEN=
